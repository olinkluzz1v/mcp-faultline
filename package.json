{
  "name": "mcp-faultline",
  "version": "0.2.0",
  "description": "Failure-mode evaluation for MCP agents. Inject faults, observe trajectory, grade resilience.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-faultline": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist dist-test",
    "test": "npm run test:proxy-smoke && npm run test:proxy && npm run test:integrity-smoke && npm run test:idempotency-smoke && npm run test:agent && npm run test:report && npm run test:demo && npm run test:run && npm run test:codex-ticket",
    "test:proxy": "node --test tests/proxy-integration.test.mjs",
    "test:agent": "node --test tests/tool-results.test.mjs",
    "test:report": "node --test tests/report-stats.test.mjs tests/report-output.test.mjs tests/report-command.test.mjs",
    "test:demo": "node --test tests/demo-scenario.test.mjs tests/demo-transient.test.mjs tests/demo-command.test.mjs",
    "test:run": "node --test tests/run-command.test.mjs",
    "test:codex-ticket": "node --test tests/codex-ticket.test.mjs",
    "test:proxy-smoke": "node dist/testing/proxy-smoke.js",
    "test:integrity-smoke": "node dist/testing/integrity-smoke.js",
    "test:idempotency-smoke": "node dist/testing/idempotency-smoke.js",
    "test:all": "npm run build && node dist/cli.js run && node dist/cli.js negative-controls && node dist/cli.js replay reports/report.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "evaluation",
    "fault-injection",
    "reliability",
    "resilience",
    "agent",
    "testing",
    "mcp-proxy"
  ],
  "author": "Gigih Susetyo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gigihsusetyo/mcp-faultline.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
